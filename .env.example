# ────────────────────────────────────────────────────────────────
# BRAND CONSTANTS — same for every property, rarely change
# (Brand colors — navy / white / gold — are fixed in
#  src/lib/buildFilterGraph.js, not here, since they're identity,
#  not a per-run setting.)
# ────────────────────────────────────────────────────────────────
BRAND_NAME=CHESTONE PROPERTIES
LOGO_PATH=./assets/logo.png
CONTACT_NUMBER=+254 726 111133
FONT_HEADER=./assets/fonts/BebasNeue-Regular.ttf
FONT_BOLD=./assets/fonts/Poppins-SemiBold.ttf
FONT_REGULAR=./assets/fonts/Poppins-Regular.ttf

# Background music — optional. URL or local path, same as IMAGES below.
# Shared across a whole batch run (resolved once), not per property.
# Leave blank for a silent video.
MUSIC_URL=

# ────────────────────────────────────────────────────────────────
# VIDEO SETTINGS — same for every property, rarely change
# 1080x1920 (9:16) = full-screen vertical for TikTok/Reels/Stories/
# Google vertical ads. Change to 1080x1080 (square) or 1080x1350
# (4:5 feed) if you ever need those instead.
# ────────────────────────────────────────────────────────────────
WIDTH=1080
HEIGHT=1920
FPS=30
IMAGE_DURATION=3.5
TRANSITION_DURATION=0.7

# ────────────────────────────────────────────────────────────────
# SINGLE-PROPERTY RUN (used by `npm start` / src/index.js)
# For many properties, don't keep editing this — use batch mode
# instead: properties/*.json + `npm run batch` (see README).
# ────────────────────────────────────────────────────────────────
PROPERTY_LOCATION=Karen, Nairobi
PRICE_KES=15M
PRICE_USD=116,000
BEDROOMS=3
OUTPUT_NAME=example-property

# Comma-separated image URLs (or local file paths), in the exact
# order they should appear in the video.
IMAGES=https://res.cloudinary.com/yourcloud/image/upload/prop1_1.jpg,https://res.cloudinary.com/yourcloud/image/upload/prop1_2.jpg,https://res.cloudinary.com/yourcloud/image/upload/prop1_3.jpg
